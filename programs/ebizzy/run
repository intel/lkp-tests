#!/bin/bash
# - nr_threads
# - nr_threads_by_instance
# - duration
# - iterations
# - mmap
# - linear

## ebizzy is designed to generate a workload resembling common
## webapplication server workloads. It is highly threaded,
## has a large in-memory working set, and allocates
## and deallocates memory frequently.

. $LKP_SRC/lib/reproduce-log.sh
. $LKP_SRC/lib/debug.sh
. $LKP_SRC/lib/run.sh

cd_benchmark

duration=${duration%%s}

[[ -n "$mmap" ]] && opt_mmap=" -m "
[[ -n "$linear" ]] && opt_linear=" -z "

# When running as multiple nr_instances (one per sibling cgroup2), let each
# instance use its own nr_threads instead of every sibling running identical
# concurrency: nr_threads_by_instance is a space-separated list, indexed by
# instance_id (1-based); an instance whose position is blank or absent keeps
# the job's shared nr_threads unchanged.
override=$(instance_override "$nr_threads_by_instance")
[[ -n "$override" ]] && nr_threads=$override

echo_instance

for i in $(seq 1 $iterations); do
	echo Iteration: $i
	log_cmd ./ebizzy -t $nr_threads -S $duration \
		$opt_mmap $opt_linear
done
