need_kconfig:
% if ___.test =~ /block/
- BLK_DEV_UBLK: m
- DEBUG_FS: y
- HOTPLUG_PCI: y
- HOTPLUG_PCI_ACPI: y
- IO_URING: y
- SCSI_DEBUG: m

% elsif ___.test =~ /nbd/
- BLK_DEV_NBD: m

% elsif ___.test =~ /nvme/
- BLK_DEV_NVME: y
- NVME_AUTH: y
- NVME_CORE: y
- NVME_FABRICS: y
- NVME_HOST_AUTH: y
- NVME_MULTIPATH: y
- NVME_TARGET: y
- NVME_TARGET_AUTH: y
- NVME_TARGET_LOOP: y
- NVME_TARGET_PASSTHRU: y
- NVME_TARGET_RDMA: y

- INFINIBAND: y
- INFINIBAND_ADDR_TRANS: y
- NVME_RDMA: y

- CRYPTO_DH: y
- CRYPTO_DH_RFC7919_GROUPS: y
- CRYPTO_HMAC: y
- CRYPTO_KPP: y
- CRYPTO_SHA256: y
- CRYPTO_SHA512: y
- FAIL_IO_TIMEOUT: y

% elsif ___.test =~ /srp/
- INFINIBAND: y
- INFINIBAND_ADDR_TRANS: y
- INFINIBAND_IPOIB: m
- INFINIBAND_SRP: m
- INFINIBAND_SRPT: m
- INFINIBAND_USER_ACCESS: m
- INFINIBAND_USER_MAD: m

% elsif ___.test =~ /zbd/
- BLK_DEV_ZONED: y
- BLK_INLINE_ENCRYPTION: y
- BLK_INLINE_ENCRYPTION_FALLBACK: y
- FS_ENCRYPTION: y
- FS_ENCRYPTION_INLINE_CRYPT: y
- SCSI_DEBUG: m
% end

- BLK_DEV_INTEGRITY: y
- BLK_DEV_LOOP: m
- BLK_DEV_NULL_BLK
- BLK_DEV_NULL_BLK_FAULT_INJECTION: y
- BTRFS_FS: m
- BTRFS_FS_POSIX_ACL: y
- DEBUG_KERNEL: y
- FAULT_INJECTION: y
- FAULT_INJECTION_CONFIGFS: y

# blktests picks the soft-RDMA driver by use_siw: siw when set, rxe otherwise.
# Use ___['key'] (nil if absent) instead of ___.key, which raises KeyError for
# a param the job does not set and then drops this whole file silently.
% if ___.test =~ /srp/ || ___['nvme_trtype'] == 'rdma'
%   if ___['use_siw'].to_s == 'true'
- RDMA_SIW: m
%   else
- RDMA_RXE: m
%   end
% end
