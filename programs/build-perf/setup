#!/bin/bash
# - ARCH

. "$LKP_SRC/lib/reproduce-log.sh"
. "$LKP_SRC/lib/common.sh"

build_perf()
{
	local perf_dir
	perf_dir=$(ls -d /usr/src/linux-perf-*/tools/perf 2>/dev/null | head -n 1)
	[[ -n "$perf_dir" ]] || return 0

	local capstone_args=()

	# e.g. CentOS/RHEL 9 Stream ships capstone 4.0.2, too old for perf's
	# libcapstone disassembler backend to build against; skip it rather
	# than fail the whole perf build.
	pkg-config --atleast-version=5 capstone 2>/dev/null || capstone_args=(NO_CAPSTONE=1)

	# tools/perf's own Makefile.perf does not fully serialize the
	# pmu-events/jevents.py code-generation step across its recursive
	# sub-makes (e.g. the perf_selftests sub-build): under very high
	# parallelism, many sub-make branches independently decide the same
	# generated file needs rebuilding at once, producing dozens of
	# redundant concurrent jevents.py invocations instead of one. This
	# is latent and harmless at ordinary core counts but turns into a
	# many-hour (or non-converging) build storm on a host with a very
	# high core count. Cap parallelism well below nr_cpu rather than
	# feeding this build an unbounded job count.
	# shellcheck disable=SC2154
	local perf_build_jobs=$((nr_cpu < 128 ? nr_cpu : 128))

	# pmu-events/jevents.py reads its JSON inputs through a
	# ProcessPoolExecutor() sized to the CPU count, and each worker costs
	# the parent several descriptors via its pipes. On a host with
	# hundreds of CPUs this exceeds the default soft RLIMIT_NOFILE and
	# jevents.py dies with "OSError: [Errno 24] Too many open files",
	# leaving perf unbuilt. Raise the soft limit to the hard limit and cap
	# the pool size (PYTHON_CPU_COUNT is honored by Python 3.13+, ignored
	# by older interpreters).
	ulimit -n "$(ulimit -Hn)" 2>/dev/null || ulimit -n 1048576 2>/dev/null
	export PYTHON_CPU_COUNT=$((nr_cpu < 32 ? nr_cpu : 32))

	log_cmd make -j"$perf_build_jobs" ARCH= "${capstone_args[@]}" -C "$perf_dir" 2>&1 || return

	[[ -f /usr/bin/perf ]] && rm -f /usr/bin/perf
	ln -s "$perf_dir"/perf /usr/bin/perf
}

build_perf

exit 0
