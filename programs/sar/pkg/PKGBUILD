pkgname=sar
pkgver=git
pkgrel=1
pkgdesc="System performance tools for the Linux operating system, contains various utilities, common to many commercial Unixes, to monitor system performance and usage activity.Includes four groups of monitoring tools (sar / sadc / sadf, iostat / tapestat / cifsiostat, mpstat, pidstat)."
arch=('i386' 'x86_64' 'riscv64' 'aarch64')
url="https://github.com/sysstat/sysstat"
license=('GPL')
source=("$pkgname"::"https://github.com/sysstat/sysstat.git")
md5sums=('SKIP')

. $LKP_SRC/lib/tests/pkgbuild.sh

build()
{
	# --enable-copy-only skips install_all's live systemctl/crontab
	# registration, which fails inside the packaging sandbox and must
	# never touch the build host anyway.
	make_src_pkg --enable-copy-only
}

package()
{
	make_install_src_pkg DESTDIR=$benchmark_path
}
