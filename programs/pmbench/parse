#!/usr/bin/env ruby

LKP_SRC ||= ENV['LKP_SRC'] || File.dirname(__dir__)
require "#{LKP_SRC}/lib/statistics"

res = 0.0
histo_r = Array.new(24, 0)
histo_w = Array.new(24, 0)
histo_details_r = []
histo_details_w = []
latencies = []
throughputs = []
init_times = []
mode = nil
READ = :read
WRITE = :write
sum = { READ => 0.0, WRITE => 0.0 }
instance = 1
per_instance = Hash.new { |h, k| h[k] = { latencies: [], throughputs: [] } }

# Bump histo_r/w, and for a detailed (sub-bucketed) line also
# histo_details_r/w, for the given mode/bucket.
def accumulate_bucket(mode, p, cnt, histo_r, histo_w, data, histo_details_r, histo_details_w)
  histo = mode == READ ? histo_r : histo_w
  histo[p] += cnt
  return unless data

  details = mode == READ ? histo_details_r : histo_details_w
  data.each_with_index do |v, i|
    details[p] ||= []
    details[p][i] ||= 0
    details[p][i] += v.to_i
  end
end

$stdin.each_line do |line|
  case line
  when /^Instance: (\d+)/
    instance = $1.to_i
  when /^Read:/
    mode = READ
  when /^Write:/
    mode = WRITE
  when /^  Page latency during benchmark \(inc. gen\): (\d+\.\d+) us \(\d+ clks\)/
    latencies << $1.to_f
    per_instance[instance][:latencies] << $1.to_f
  when / Benchmark done - took (\d+\.\d+) sec for (\d+) page access/
    throughput = $2.to_f / $1.to_f
    throughputs << throughput
    per_instance[instance][:throughputs] << throughput
  when /nitialization took (\d+\.\d+) ms/
    init_times << ($1.to_f / 1000)
  when /^2\^\((\d+),(\d+)\) ns: (\d+)  \[(.*)\]/
    cnt = $3.to_i
    sum[mode] += cnt
    accumulate_bucket(mode, $2.to_i - 8, cnt, histo_r, histo_w, $4.split(', '), histo_details_r, histo_details_w)
  when /^2\^\((\d+),(\d+)\) ns: (\d+)/
    end_n = $2.to_i
    cnt = $3.to_i
    sum[mode] += cnt
    p = end_n < 32 ? end_n - 8 : end_n - 9
    accumulate_bucket(mode, p, cnt, histo_r, histo_w, nil, histo_details_r, histo_details_w)
  end
end

sum_r = sum[READ]
sum_w = sum[WRITE]

def format_power2(num)
  p = 0
  unit = ['', 'K', 'M', 'G']
  while num > 9
    num -= 10
    p += 1
  end
  (1 << num).to_s + unit[p]
end

def gen_output(mode, i, res)
  if i.zero?
    puts "#{mode}.latency.ns.0-256%: #{res}"
  elsif i == 23
    puts "#{mode}.latency.ns.1G-inf%: #{res}"
  else
    puts "#{mode}.latency.ns.#{format_power2(i + 7)}-#{format_power2(i + 8)}%: #{res}"
  end
end

percentile_strs = %w(90 95 99)
percentiles = percentile_strs.map(&:to_f)

[[histo_r, histo_details_r, sum_r, READ], [histo_w, histo_details_w, sum_w, WRITE]].each do |histo, histo_details, sum, mode|
  pi = 0
  hist_cum = 0
  24.times do |i|
    next if sum == 0.0

    res = histo[i] / sum * 100
    gen_output(mode, i, res)
    if histo_details[i]
      histo_details[i].each_with_index do |v, j|
        res = v / sum * 100
        hist_cum += res
        while pi < percentiles.length && hist_cum >= percentiles[pi]
          puts "#{mode}.latency.#{percentile_strs[pi]}%.ns: #{(2**(i + 8)) + (j * (2**(i + 4)))}"
          pi += 1
        end
      end
    else
      hist_cum += res
      while pi < percentiles.length && hist_cum >= percentiles[pi]
        puts "#{mode}.latency.#{percentile_strs[pi]}%.ns: #{2**(i + 8)}"
        pi += 1
      end
    end
  end
end

unless latencies.empty?
  latency_avg = latencies.sum / latencies.length
  puts "latency.ns.average: #{latency_avg * 1000}"
end

puts "throughput.aps: #{throughputs.sum}"
puts "throughput.std_dev%: #{throughputs.standard_deviation * 100 / throughputs.average}"

unless init_times.empty?
  init_time_avg = init_times.sum / init_times.length
  puts "init_time.avg: #{init_time_avg}"
end

# Per-instance breakdown: only meaningful when nr_instances > 1 (e.g. a
# cgroup2 job with asymmetric setsize_by_instance across sibling cgroups);
# a plain single-instance run only ever populates instance 1, so it adds
# nothing beyond the combined stats above.
if per_instance.size > 1
  per_instance.sort.each do |id, stat|
    puts "latency.ns.average.instance#{id}: #{(stat[:latencies].sum / stat[:latencies].length) * 1000}" unless stat[:latencies].empty?

    next if stat[:throughputs].empty?

    puts "throughput.aps.instance#{id}: #{stat[:throughputs].sum}"
  end
end
