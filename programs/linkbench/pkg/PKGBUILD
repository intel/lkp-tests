pkgname=linkbench
pkgver=git
pkgrel=1
arch=('i386' 'x86_64' 'aarch64')
url="https://github.com/facebookarchive/linkbench"
license=(Apache License)
depends=('')
source=('https://github.com/facebookarchive/linkbench.git')
md5sums=('SKIP')

. $LKP_SRC/lib/tests/pkgbuild.sh

# Maven runs on the JVM, which ignores the http_proxy/https_proxy
# environment variables that every other build tool honors, so a build
# behind a proxy hangs downloading plugins from Maven Central. Translate
# them into the equivalent JVM proxy properties.
set_maven_proxy()
{
	local scheme proxy hostport

	for scheme in http https; do
		eval "proxy=\${${scheme}_proxy}"
		[[ $proxy ]] || continue

		hostport=${proxy#*://}
		hostport=${hostport%%/*}
		hostport=${hostport##*@}

		MAVEN_OPTS+=" -D${scheme}.proxyHost=${hostport%%:*}"
		[[ $hostport = *:* ]] && MAVEN_OPTS+=" -D${scheme}.proxyPort=${hostport##*:}"
	done

	export MAVEN_OPTS
}

build()
{
	cd_src_pkg_dir

	set_maven_proxy

	# pom.xml hardcodes maven-compiler-plugin source/target 1.7, which
	# javac from JDK 8+ rejects outright ("Source option 7 is no longer
	# supported. Use 8 or later."); bump to the oldest version javac
	# still accepts.
	sed -i \
		-e 's|<source>1.7</source>|<source>1.8</source>|' \
		-e 's|<target>1.7</target>|<target>1.8</target>|' \
		pom.xml

	mvn clean package -DskipTests || {
		echo -e "\e[31msetup network proxy please refer to https://maven.apache.org/guides/mini/guide-proxies.html\e[0m" >&2
		echo

		return 1
	}
}

