#!/usr/bin/env ruby

LKP_SRC = ENV['LKP_SRC'] || File.dirname(File.realpath($PROGRAM_NAME), 2)

require 'optparse'
require 'ostruct'
require 'shellwords'
require 'yaml'

options = { name_prefix: '' }

opt_parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{$PROGRAM_NAME} [options] YAML-FILE"

  opts.separator ''
  opts.separator 'options:'

  opts.on('--expand', 'Enable "$shell_variable" expansion') { options[:expand_shell_variable] = true }

  opts.on('--array ARRAY', 'Store values to associative array') { |array_name| options[:assoc_array] = array_name }

  opts.on('--prefix PREFIX', 'Add prefix to variable names') { |prefix| options[:name_prefix] = prefix }

  opts.on_tail('-h', '--help', 'Show this message') do
    puts opts
    exit
  end
end

argv = if ARGV == []
         ['-h']
       else
         ARGV
       end
opt_parser.parse!(argv)

def get_simple_value(v)
  if v.instance_of?(Hash)
    v.keys[0]
  elsif v.instance_of?(Array)
    v.map! do |vv|
      if vv.instance_of?(Hash)
        vv.keys[0]
      else
        vv.to_s
      end
    end
    v.join "\n"
  else
    v.to_s
  end
end

def shell_escape(v, options)
  if options[:expand_shell_variable] && v.index('$')
    "\"#{v}\""
  else
    Shellwords.escape(v)
  end
end

ARGV.each do |file|
  next if file.nil? || file.empty? || !File.exist?(file)

  begin
    vars = YAML.unsafe_load_file file
  rescue Psych::Exception => e
    warn "fail to parse file #{file} as YAML: #{e.message}"
    next
  end

  unless vars
    warn "fail to load file #{file} which results in #{vars.inspect}"
    next
  end

  vars.each do |k, v|
    next unless k.is_a?(String)

    var_name = options[:name_prefix] + k.gsub(/[^a-zA-Z0-9_]/, '_').gsub(/^[^a-zA-Z]/, '_')
    var_name = "#{options[:assoc_array]}[#{var_name}]" if options[:assoc_array]
    $stdout.write("#{var_name}=#{shell_escape(get_simple_value(v), options)}\n")
  end
end
