#!/bin/sh

export PATH="$PATH:/usr/lib/klibc/bin"

. /usr/share/initramfs-tools/scripts/functions

DEVICE=${DIRECT_DEVICE:-eth0}
IP=$DIRECT_IP

read_ip()
{
	# shellcheck disable=SC2013
	for x in $(cat /proc/cmdline); do
		case $x in
		ip=*)
			IP="${x#ip=}"
			;;
		esac
	done
}

[ -n "$IP" ] || read_ip

# define variables required by configure_networking
if grep -wq quiet /proc/cmdline; then
	quiet=y
else
	quiet=n
fi

starttime=$(cat /proc/uptime | awk '{print int($1)+1}')

configure_networking
