# /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor: No such file or directory
cpufreq_governor:

# refer to arch/x86/configs/kvm_guest.config
# KVM_GUEST is x86 only, so a riscv64 guest cannot satisfy it
% if job['model'].to_s !~ /riscv64/
need_kconfig_hw:
- KVM_GUEST: y
% end

kernel_cmdline_hw: vmalloc=256M initramfs_async=0 page_owner=on carrier_timeout=60 rcupdate.rcu_self_test=0
